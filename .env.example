# Buildwise Local Environment Template (Placeholders Only — Never Commit Real Secrets)
# Copy this file to .env on your development machine (excluded by .gitignore).

# Application environment
APP_ENV=development
BUILDWISE_NO_LLM_MODE=true
BUILDWISE_USE_FAKE_PROVIDER=true

# Database (PostgreSQL + pgvector) — values to be finalized after Phase 1 setup
DATABASE_URL=

# Authentication / Session secrets — format depends on unresolved ADR-0003 owner decision
SESSION_SECRET=

# Model Gateway (Server-side only — never expose in browser code, logs, prompts, or DB plaintext)
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
EXPLABS_API_KEY=
EXPLABS_FABLE_MODEL=claude-fable-5.2

# Feature flags — security-sensitive capabilities remain OFF until Phase 6/8 gates and owner reviews pass
ENABLE_WORKSPACE_WRITES=false
ENABLE_TEST_SANDBOX=false
ENABLE_LOCAL_CONNECTOR=false
ENABLE_ENTERPRISE_FEATURES=false
